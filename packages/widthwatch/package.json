{
  "name": "widthwatch",
  "version": "0.4.15",
  "description": "Continuous responsive visual regression testing with adaptive viewport discovery",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "visual-regression",
    "responsive",
    "playwright",
    "screenshots",
    "testing",
    "ci"
  ],
  "homepage": "https://damianociarla.github.io/widthwatch/",
  "bugs": {
    "url": "https://github.com/damianociarla/widthwatch/issues"
  },
  "bin": {
    "widthwatch": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damianociarla/widthwatch.git",
    "directory": "packages/widthwatch"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "coverage": "npm run build && npm run coverage:all && npm run coverage:config && npm run coverage:cli",
    "coverage:all": "node --test --experimental-test-coverage --test-coverage-lines=78 --test-coverage-branches=78 --test-coverage-functions=85 --test-coverage-include='dist/**/*.js' test/*.test.mjs",
    "coverage:config": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-coverage-include='dist/config.js' test/config.test.mjs",
    "coverage:cli": "node --test --experimental-test-coverage --test-coverage-lines=55 --test-coverage-branches=15 --test-coverage-functions=60 --test-coverage-include='dist/cli.js' test/cli-options.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "pixelmatch": "^7.1.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
