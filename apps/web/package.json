{
  "name": "@widthwatch/web",
  "version": "0.4.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "coverage": "VITE_COVERAGE=true VITE_API_URL=/api npm run build && node test/browser-coverage.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
