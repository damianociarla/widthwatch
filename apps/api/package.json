{
  "name": "@widthwatch/api",
  "version": "0.4.8",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "coverage": "npm run build && npm run coverage:all && npm run coverage:http && npm run coverage:network && npm run coverage:egress && npm run coverage:budget && npm run coverage:hosted && npm run coverage:outcome",
    "coverage:all": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-exclude='dist/server.js' --test-coverage-include='dist/**/*.js' test/*.test.mjs",
    "coverage:http": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=85 --test-coverage-include='dist/http-admission.js' test/http-admission.test.mjs",
    "coverage:network": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-coverage-include='dist/network-policy.js' test/network-policy.test.mjs",
    "coverage:egress": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include='dist/egress-proxy.js' test/egress-proxy.test.mjs",
    "coverage:budget": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=100 --test-coverage-include='dist/egress-budget.js' test/egress-budget.test.mjs",
    "coverage:hosted": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=100 --test-coverage-include='dist/hosted-scan.js' test/hosted-scan.test.mjs",
    "coverage:outcome": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=100 --test-coverage-include='dist/job-outcome.js' test/job-outcome.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "ipaddr.js": "^2.2.0",
    "widthwatch": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
